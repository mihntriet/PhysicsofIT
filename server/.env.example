# ===== Server =====
PORT=3000

# ===== MQTT Broker =====
MQTT_BROKER_URL=mqtt://broker.hivemq.com
MQTT_TOPIC_GAS_DATA=gas/sensor/data
MQTT_TOPIC_CONTROL_BUZZER=gas/control/buzzer
MQTT_TOPIC_CONTROL_LED=gas/control/led

# ===== Gas Threshold =====
# Giá trị ADC ngưỡng cảnh báo (0-4095 cho ESP32 12-bit ADC)
GAS_THRESHOLD=2000

# ===== Firebase Admin SDK =====
# Đường dẫn đến file Service Account Key JSON (tải từ Firebase Console)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
# URL của Firebase Realtime Database
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-ID.firebaseio.com
