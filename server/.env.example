# HTTP server
HOST=0.0.0.0
PORT=3000

# Device
DEVICE_ID=ESP32-GAS-MONITOR

# Local Mosquitto (Node.js and Mosquitto run on the same laptop)
MQTT_BROKER_URL=mqtt://LAPTOP-C1259HLI:1883
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Device-specific MQTT topics
MQTT_TOPIC_GAS_DATA=devices/ESP32-GAS-MONITOR/gas/data
MQTT_TOPIC_GAS_ALERT=devices/ESP32-GAS-MONITOR/gas/alert
MQTT_TOPIC_CONTROL_BUZZER=devices/ESP32-GAS-MONITOR/control/buzzer
MQTT_TOPIC_BUZZER_STATE=devices/ESP32-GAS-MONITOR/status/buzzer
MQTT_TOPIC_AVAILABILITY=devices/ESP32-GAS-MONITOR/status/availability

# Firebase Admin
FIREBASE_SERVICE_ACCOUNT_PATH=./config/serviceAccountKey.json
FIREBASE_DATABASE_URL=

# Pushsafer
PUSHSAFER_PRIVATE_KEY=
PUSHSAFER_DEVICE_ID=

# Realtime Database history sampling
HISTORY_SAVE_INTERVAL_MS=30000
